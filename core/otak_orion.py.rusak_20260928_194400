        potongan = it["pesan_asli"]
        print(f"\n[Auto-Chain {i}/{len(intents)}] {tipe}")
        
        det = {"butuh_eksekusi": True, "tipe": tipe, "pesan_asli": potongan}
        
        # Panggil tool langsung (bukan lewat eksekusi_dari_pesan karena butuh det)
